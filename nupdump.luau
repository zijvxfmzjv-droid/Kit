        if depth > 3 then return "..." end
        local tv = type(v)
        if tv == "string" then return string.format("%q", v):gsub("\\n", " ") end
        if tv == "table" then
            local parts = {}
            local cnt = 0
            for k2, v2 in pairs(v) do
                cnt = cnt + 1
                if cnt > 200 then parts[#parts+1] = "..." break end
                parts[#parts+1] = tostring(k2) .. "=" .. valstr(v2, depth + 1)
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end
        if tv == "function" then return "FN:" .. tostring(v):gsub("0x%x+", "ADDR") end
        return tv .. ":" .. tostring(v):gsub("0x%x+", "ADDR")
    end
