ANYMT = {
    __index = function(t, k) L("idx", t.__tag, k); return ANY(t.__tag .. "[" .. tostring(k) .. "]") end,
    __newindex = function(t, k, v) L("setidx", t.__tag, tostring(k) .. "=" .. (type(v) == "table" and v.__tag or tostring(v))) end,
    __call = function(t, ...) L("call", t.__tag, select('#', ...)); return ANY(t.__tag .. "()") end,
    __add = function(a, b) L("op", "add", type(b) == "table" and b.__tag or tostring(b)); return ANY("add") end,
    __sub = function(a, b) L("op", "sub", ""); return ANY("sub") end,
