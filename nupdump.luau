local function ser(v, depth, seen, out)
    local tv = type(v)
    if tv == "number" then
        if v ~= v then out[#out+1] = "NAN"
        elseif v == math.huge then out[#out+1] = "INF"
        elseif v == -math.huge then out[#out+1] = "NINF"
        else out[#out+1] = string.format("%.17g", v) end
    elseif tv == "string" then
        local e = v:gsub("\\", "\\\\")
        e = e:gsub("\n", "\\n"):gsub("\r", "\\r")
        e = e:gsub("\1", "\\x01"):gsub("\2", "\\x02"):gsub("\3", "\\x03")
        out[#out+1] = "s" .. tostring(#e) .. ":" .. e
    elseif tv == "boolean" then
        out[#out+1] = tostring(v) and "b1" or "b0"
    elseif tv == "function" then
        out[#out+1] = "F"
    elseif tv == "table" then
        if seen[v] then out[#out+1] = "t" .. seen[v]; return end
        if depth > 14 then out[#out+1] = "DEEP"; return end
        seen.__n = (seen.__n or 0) + 1
        local id = seen.__n
        seen[v] = id
        out[#out+1] = "T" .. id
        local keys = {}
        for k, _ in pairs(v) do keys[#keys+1] = k end
        table.sort(keys, function(a, b)
            local ta, tb = type(a), type(b)
            if ta ~= tb then return ta < tb end
            if ta == "number" then return a < b end
            return tostring(a) < tostring(b)
        end)
        for _, k in ipairs(keys) do
            if k ~= "__captured" and k ~= "__dummyname" then
                out[#out+1] = "\x01"
                ser(k, depth + 1, seen, out)
                out[#out+1] = "\x02"
                ser(v[k], depth + 1, seen, out)
            end
        end
        out[#out+1] = "\x03"
    else
        out[#out+1] = "?" .. tv
    end
end
