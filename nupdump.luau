}
local function mkstream(name, val)
    local t = setmetatable({}, {
        __index = function(tt, k) L("rd", name, k); return val end,
        __newindex = function(tt, k, v) L("wr_stream", name, tostring(k)) end,
    })
    return t
end
local function mkE()
    local regs = {}
    for i = 0, 30 do regs[i] = ANY("E" .. i) end
    local t = setmetatable({}, {
        __index = function(tt, k) L("rdE", k, ""); return regs[k] or ANY("E?") end,
        __newindex = function(tt, k, v)
            L("wrE", k, type(v) == "table" and (v.__tag or "tbl") or tostring(v))
            rawset(regs, k, v)
        end,
        __len = function(tt) return 20 end,
    })
    return t
end

